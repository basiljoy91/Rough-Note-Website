# Public site origin. Add comma-separated alternates only when they are real.
APP_ORIGIN=https://your-domain.com
ALLOWED_ORIGINS=https://www.your-domain.com
CONTACT_REQUIRE_ORIGIN=true
TRUST_PROXY_HOPS=1
PORT=3000
NODE_ENV=production

# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
CONTACT_IP_LIMIT=5
CONTACT_EMAIL_LIMIT=3
CONTACT_RATE_WINDOW_SECONDS=3600
NEWSLETTER_IP_LIMIT=10
NEWSLETTER_EMAIL_LIMIT=3
NEWSLETTER_RATE_WINDOW_SECONDS=3600
NEWSLETTER_VERIFY_TOKEN_HOURS=48
NEWSLETTER_RESEND_COOLDOWN_SECONDS=900

# Studio availability is Monday-Friday, 10:00-17:00 IST by default.
# Asia/Kolkata has a fixed +05:30 offset and no daylight-saving transitions.
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_UTC_OFFSET_MINUTES=330
SCHEDULER_WEEKDAYS=1,2,3,4,5
SCHEDULER_START_HOUR=10
SCHEDULER_END_HOUR=17
SCHEDULER_SLOT_MINUTES=30
SCHEDULER_LEAD_MINUTES=60
SCHEDULER_HORIZON_DAYS=60

# Dedicated Rough Note Google Calendar OAuth credentials.
GOOGLE_CALENDAR_ID=replace-with-calendar-id@group.calendar.google.com
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-one-time-oauth-refresh-token
GOOGLE_API_TIMEOUT_MS=8000
STUDIO_OFFICE_ADDRESS=Rough Note Studio

# Hostinger MySQL (normally localhost for a database on the same account).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace-with-hostinger-database-name
DB_USER=replace-with-hostinger-database-user
DB_PASSWORD=replace-with-hostinger-database-password
DB_CONNECTION_LIMIT=5
DB_SSL=false
DB_AUTO_MIGRATE=true

# Hostinger Email SMTP.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@your-domain.com
SMTP_PASSWORD=replace-with-mailbox-password
MAIL_FROM="Rough Note Website <hello@your-domain.com>"
CONTACT_TO_EMAIL=hello@your-domain.com
MAIL_TIMEOUT_MS=8000

# Phase 6 operations. Generate each secret independently.
# openssl rand -hex 32
MAINTENANCE_SECRET=replace-with-a-separate-64-character-hex-secret
# openssl rand -hex 32 (must be exactly 64 hexadecimal characters)
OUTBOX_ENCRYPTION_KEY=replace-with-a-separate-64-character-hex-key
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_RETRY_BASE_SECONDS=300
OUTBOX_LOCK_TIMEOUT_SECONDS=900

# Data-retention windows. Maintenance applies these once per day.
RATE_LIMIT_RETENTION_DAYS=2
ATTACHMENT_RETENTION_DAYS=30
CONTACT_RETENTION_DAYS=365
BOOKING_RETENTION_DAYS=365
NEWSLETTER_PENDING_RETENTION_DAYS=7
NEWSLETTER_UNSUBSCRIBED_RETENTION_DAYS=90
OUTBOX_SENT_RETENTION_DAYS=30
OUTBOX_DEAD_RETENTION_DAYS=90
MAINTENANCE_RUN_RETENTION_DAYS=180
